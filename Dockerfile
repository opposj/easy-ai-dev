FROM ubuntu:24.04 AS prep_brew
ENV NONINTERACTIVE=1 HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_SANDBOX_LINUX=1 HOMEBREW_NO_AUTO_UPDATE=1
RUN --mount=type=cache,target=/var/lib/apt/lists,sharing=locked --mount=type=cache,target=/var/cache/apt,sharing=locked --mount=type=cache,target=/root/.cache,sharing=locked echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/docker-clean && apt update && apt install -y curl git && { git clone --mirror https://github.com/Homebrew/brew /root/.cache/homebrew-git; git config --global url."file:///root/.cache/homebrew-git".insteadOf "https://github.com/Homebrew/brew"; } && touch /.dockerenv && /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" && for i in 1 2 3 4 5; do /home/linuxbrew/.linuxbrew/bin/brew install glibc gcc curl git zsh && { echo "[Attempt $i] Success" && success=1 && break; } || { echo "[Attempt $i] Failed" && success=0 && sleep 1; }; done && if [ $success = 1 ]; then /home/linuxbrew/.linuxbrew/bin/brew cleanup --prune=all && /home/linuxbrew/.linuxbrew/bin/brew cleanup --prune-prefix && rm -rf /home/linuxbrew/.linuxbrew/Homebrew/Library/Homebrew/vendor/portable-ruby && mv /home/linuxbrew/.linuxbrew/Homebrew/.git/index /root/.cache/homebrew_index && mv /home/linuxbrew/.linuxbrew/opt/glibc/lib/locale/locale-archive /root/.cache/locale-archive; else exit 1; fi

FROM prep_brew AS tier
ARG TIER=full TUI= LANGS= AGENTS=
COPY scripts/resolve-tier.zsh /tmp/resolve-tier.zsh
RUN /home/linuxbrew/.linuxbrew/bin/zsh /tmp/resolve-tier.zsh "$TIER" "$TUI" "$LANGS" "$AGENTS" > /root/.tier.env

FROM ubuntu:24.04 AS brewed
COPY --from=prep_brew /home/linuxbrew/.linuxbrew /home/linuxbrew/.linuxbrew
COPY --from=tier /root/.tier.env /root/.tier.env
ENV HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_SANDBOX_LINUX=1 HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_CURL_PATH=/home/linuxbrew/.linuxbrew/bin/curl HOMEBREW_GIT_PATH=/home/linuxbrew/.linuxbrew/bin/git
RUN --mount=type=cache,target=/root/.cache,sharing=locked cp /root/.cache/homebrew_index /home/linuxbrew/.linuxbrew/Homebrew/.git/index && cp /root/.cache/locale-archive /home/linuxbrew/.linuxbrew/opt/glibc/lib/locale/locale-archive && touch /.dockerenv && find /home/linuxbrew/.linuxbrew/bin -type l \( -name 'gcc-[0-9]*' -execdir ln -s {} gcc \; -execdir ln -s {} cc \; -o -name 'g++-[0-9]*' -execdir ln -s {} g++ \; \) && . /root/.tier.env && formulae="$CORE_FORMULAE $TUI_FORMULAE $LANG_FORMULAE" && for i in 1 2 3 4 5; do /home/linuxbrew/.linuxbrew/bin/brew install $formulae && { echo "[Attempt $i] Success" && success=1 && break; } || { echo "[Attempt $i] Failed" && success=0 && sleep 1; }; done && if [ $success = 1 ]; then /home/linuxbrew/.linuxbrew/bin/brew cleanup --prune=all && /home/linuxbrew/.linuxbrew/bin/brew cleanup --prune-prefix && rm -rf /home/linuxbrew/.linuxbrew/Homebrew/Library/Homebrew/vendor/portable-ruby && rm -rf /var/tmp/* && mv /home/linuxbrew/.linuxbrew/opt/glibc/lib/locale/locale-archive /root/.cache/locale-archive && mv /root/.homebrew/trust.json /root/.cache/trust.json; else exit 1; fi

FROM brewed AS agent_env
ENV EDITOR=vim SHELL=/home/linuxbrew/.linuxbrew/bin/zsh ZSH=/opt/oh-my-zsh ZSH_THEME= SSL_CERT_FILE=/home/linuxbrew/.linuxbrew/opt/ca-certificates/share/ca-certificates/cacert.pem LANG=en_US.utf8 LC_ALL=en_US.utf8 TERM=xterm-256color COLORTERM=truecolor LIBRARY_PATH="/home/linuxbrew/.linuxbrew/opt/glibc/lib" LD_LIBRARY_PATH="/home/linuxbrew/.linuxbrew/opt/gcc/lib/gcc/current" SDKROOT="/home/linuxbrew/.linuxbrew/opt/glibc" LDFLAGS="-L/home/linuxbrew/.linuxbrew/opt/glibc/lib" CPPFLAGS="-I/home/linuxbrew/.linuxbrew/opt/glibc/include" XDG_DATA_HOME="/home/linuxbrew/.linuxbrew/share" XDG_DATA_DIRS="/home/linuxbrew/.linuxbrew/share:/root/.local/share:/usr/local/share:/usr/share" FORGE_TERM_MAX_COMMANDS=20 ZSH_BASH_COMPLETIONS_FALLBACK_PATH="/home/linuxbrew/.linuxbrew/opt/rustup/etc/bash_completion.d:/home/linuxbrew/.linuxbrew/etc/bash_completion.d" ZSH_BASH_COMPLETIONS_FALLBACK_LAZYLOAD_AUTO_UPDATE=1 DOTNET_ROOT="/home/linuxbrew/.linuxbrew/opt/dotnet/libexec"
RUN --mount=type=cache,target=/root/.cache,sharing=locked cp /root/.cache/locale-archive /home/linuxbrew/.linuxbrew/opt/glibc/lib/locale/locale-archive && export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH" && I18NPATH=/home/linuxbrew/.linuxbrew/opt/glibc/share/i18n /home/linuxbrew/.linuxbrew/opt/glibc/bin/localedef --no-hard-links -i en_US -f UTF-8 /usr/lib/locale/en_US.utf8 && /home/linuxbrew/.linuxbrew/opt/glibc/bin/localedef --add-to-archive --replace /usr/lib/locale/en_US.utf8 && . /root/.tier.env && if [ "$TUI" = 1 ]; then { git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git /root/.cache/oh-my-zsh; cp -a /root/.cache/oh-my-zsh $ZSH; } && { git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions.git /root/.cache/zsh-autosuggestions; cp -a /root/.cache/zsh-autosuggestions $ZSH/custom/plugins/zsh-autosuggestions; } && { git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting.git /root/.cache/zsh-syntax-highlighting; cp -a /root/.cache/zsh-syntax-highlighting $ZSH/custom/plugins/zsh-syntax-highlighting; } && { git clone --depth=1 https://github.com/opposj/zsh-bash-completions-fallback.git /root/.cache/zsh-bash-completions-fallback; cp -a /root/.cache/zsh-bash-completions-fallback $ZSH/custom/plugins/zsh-bash-completions-fallback; } && echo 'XTerm*metaSendsEscape: true' >> /root/.Xresources && ya pkg add yazi-rs/plugins:full-border && echo 'require("full-border"):setup()' >> /root/.config/yazi/init.lua && ya pkg add dangooddd/kanagawa && printf '%b\n' '[flavor]\ndark = "kanagawa"' >> /root/.config/yazi/theme.toml; fi && if [ "$QUICKLISP" = 1 ]; then if [ ! -d /root/.cache/.quicklisp ]; then curl -o /root/.cache/ql.lisp http://beta.quicklisp.org/quicklisp.lisp && sbcl --load /root/.cache/ql.lisp --eval '(quicklisp-quickstart:install :path "/root/.cache/.quicklisp")' --quit; fi && cp -a /root/.cache/.quicklisp /root/.quicklisp && rm -rf /root/.quicklisp/tmp && sbcl --load /root/.quicklisp/setup.lisp --eval '(ql-util:without-prompting (ql:add-to-init-file))' --quit; fi && if [ "$ALIRE" = 1 ]; then if [ ! -f /root/.cache/alire.zip ]; then curl -Lo /root/.cache/alire.zip $(curl -s https://api.github.com/repos/alire-project/alire/releases/latest | rg '"browser_download_url": "(.*x86_64-linux.zip)"' -or '$1'); fi && unzip /root/.cache/alire.zip 'bin/alr' -d /home/linuxbrew/.linuxbrew; fi && if [ "$MOONBIT" = 1 ]; then if [ -x /root/.cache/.moon/bin/moon ]; then cp -a /root/.cache/.moon /root/.moon; else curl -fsSL https://cli.moonbitlang.com/install/unix.sh | PATH="/root/.moon/bin:$PATH" bash && cp -a /root/.moon /root/.cache/.moon; fi; fi && printf '%s\n' '#!/home/linuxbrew/.linuxbrew/bin/zsh' 'if [[ $# -gt 0 ]]; then exec "$@"; fi' 'exec /home/linuxbrew/.linuxbrew/bin/zsh' > /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh
COPY .zshenv .zshrc .vimrc /root/
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

FROM scratch AS agent_asset
COPY asset/deepseek-models.json /deepseek-models.json

FROM agent_env AS agent
ARG NPM_CONFIG_CACHE=/root/.cache/npm NODE_COMPILE_CACHE=/root/.cache/node-compile-cache UV_LINK_MODE=copy
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked --mount=type=cache,target=/root/.cache,sharing=locked --mount=type=bind,from=agent_asset,source=/,target=/tmp/agent_asset cp /root/.cache/trust.json /root/.homebrew/trust.json && export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH" && set -e && . /root/.tier.env && formulae="$DEPS" && posteval= && for a in $AGENTS; do case $a in forgecode) formulae="$formulae forgecode";; tmuxai) formulae="$formulae tmuxai";; codex) formulae="$formulae codex" && install -Dm 0644 /tmp/agent_asset/deepseek-models.json /root/.codex/models.json;; claude) formulae="$formulae claude-code@latest";; opencode) formulae="$formulae anomalyco/tap/opencode";; pi) formulae="$formulae pi-coding-agent";; omp) formulae="$formulae can1357/tap/omp";; jcode) formulae="$formulae 1jehuang/jcode/jcode";; hermes) formulae="$formulae hermes-agent";; crush) formulae="$formulae charmbracelet/tap/crush";; grok) formulae="$formulae grok-build";; reasonix) formulae="$formulae esengine/reasonix/reasonix";; droid) if [ -x /root/.cache/droid ]; then install -Dm 0755 /root/.cache/droid /root/.local/bin/droid; else curl -fsSL https://app.factory.ai/cli | sh && cp /root/.local/bin/droid /root/.cache/droid; fi;; goose) formulae="$formulae block-goose-cli";; aider) formulae="$formulae aider";; copilot) formulae="$formulae copilot-cli" && posteval="$posteval rm -rf /var/tmp/* && mv /home/linuxbrew/.linuxbrew/bin/copilot /home/linuxbrew/.linuxbrew/bin/_shimmed_copilot && printf '%s\n' '#!/home/linuxbrew/.linuxbrew/bin/zsh' 'set -a' '[ -f /root/.copilot/.env ] && source /root/.copilot/.env' 'exec /home/linuxbrew/.linuxbrew/bin/_shimmed_copilot \"\$@\"' > /home/linuxbrew/.linuxbrew/bin/copilot && chmod +x /home/linuxbrew/.linuxbrew/bin/copilot;";; cline) posteval="$posteval bun i -g cline && rm -f /tmp/.*.hm;";; codebuddy) formulae="$formulae Tencent-CodeBuddy/tap/codebuddy-code";; kilo) formulae="$formulae Kilo-Org/tap/kilo";; kimi) formulae="$formulae kimi-code";; qwen) formulae="$formulae qwen-code";; mcode) posteval="$posteval bun i -g @minimax-ai/code && rm -f /tmp/.*.hm && rm -f /root/.npm/_prebuilds/*sqlite3*.tar.gz;";; qoder) posteval="$posteval bun i -g @qoder-ai/qodercli && rm -f /tmp/.*.hm;";; prime) posteval="$posteval curl -fsSL https://app.primeintellect.ai/prime-agent/install.sh | sh;";; deepagents) posteval="$posteval curl -LsSf https://langch.in/dcode | env DEEPAGENTS_CODE_EXTRAS=deepseek DEEPAGENTS_CODE_YES=1 DEEPAGENTS_CODE_NO_MODIFY_PATH=1 bash && rm -f /tmp/uv*;";; openhands) posteval="$posteval uv tool install openhands --python 3.12 && rm -f /tmp/uv*;";; deepcode) posteval="$posteval bun i -g @vegamo/deepcode-cli && rm -f /tmp/.*.hm;";; atomic) posteval="$posteval if [ -s /root/.cache/atomic-agent.tar.gz ]; then tar -C /root -xzf /root/.cache/atomic-agent.tar.gz; else curl -fsSL https://atomicagent.io/install | env ATOMIC_AGENT_NO_PATH=1 ATOMIC_AGENT_INSTALL_DIR=/root/.local/atomic-agent sh && tar -C /root -czf /root/.cache/atomic-agent.tar.gz .local/atomic-agent; fi && ln -s /root/.local/atomic-agent/atomic-agent /home/linuxbrew/.linuxbrew/bin/atag;";; letta) formulae="$formulae letta-code";; zerostack) formulae="$formulae gi-dellav/tap/zerostack";; mimo) formulae="$formulae mimo-code";; *) echo "Unknown agent: $a"; exit 1;; esac; done && for i in 1 2 3 4 5; do brew install $formulae && { echo "[Attempt $i] Success" && success=1 && break; } || { if [ -z "$formulae" ]; then success=1 && break; else echo "[Attempt $i] Failed" && success=0 && sleep 1; fi }; done && if [ "$success" != 1 ]; then exit 1; fi && eval "$posteval"; brew cleanup --prune=all && brew cleanup --prune-prefix
